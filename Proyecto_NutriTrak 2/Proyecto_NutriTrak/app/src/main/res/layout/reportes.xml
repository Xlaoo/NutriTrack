<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="25dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="NutriTrack"
            android:textAlignment="center"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#009739"
            android:layout_marginTop="15dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Reportes del sistema"
            android:textAlignment="center"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="30dp"/>

        <TextView
            android:id="@+id/txtTotalUsuarios"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="👥 Usuarios registrados\nCargando..."
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:gravity="center"
            android:padding="25dp"
            android:background="#FFFFFF"
            android:layout_marginBottom="15dp"/>

        <TextView
            android:id="@+id/txtTotalAlimentos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🥗 Alimentos registrados\nCargando..."
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:gravity="center"
            android:padding="25dp"
            android:background="#FFFFFF"
            android:layout_marginBottom="15dp"/>

        <TextView
            android:id="@+id/txtTotalConsumos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🍽 Consumos registrados\nCargando..."
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:gravity="center"
            android:padding="25dp"
            android:background="#FFFFFF"
            android:layout_marginBottom="25dp"/>

        <Button
            android:id="@+id/btnVolver"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="VOLVER"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#555555"/>

    </LinearLayout>

</ScrollView>